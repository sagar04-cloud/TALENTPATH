# =========================================================================
# TALENT PATH SOLUTIONS - ENVIRONMENT VARIABLES CONFIGURATION TEMPLATE
# =========================================================================

# 1. Firebase Backend & Realtime Database Integration
# Obtain these from Firebase Console -> Project Settings -> General -> Your apps -> Web app config:
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_DATABASE_URL=https://your-project-id-default-rtdb.firebaseio.com

# 2. Google Analytics 4 Measurement ID
# Obtain from GA4 Admin -> Data Streams -> Measurement ID
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# 3. Canonical Website URL
VITE_SITE_URL=https://talentpathsolutions.com
